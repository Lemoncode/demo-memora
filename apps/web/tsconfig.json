{
  "extends": "../../tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["dist", ".output", ".nitro", ".tanstack"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "#/*": ["./src/*"]
    }
  }
}
