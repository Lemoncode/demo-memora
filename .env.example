# Copy this file to `.env` at the repository root and adjust if you need to.
# `.env` is git-ignored; this example is versioned.
#
# Only `packages/db` (@memora/db) reads this value — it is the single door to Mongo.
# It must point at the database the local Docker container publishes (`pnpm db:up`).
MONGODB_URI=mongodb://localhost:27017/memora
